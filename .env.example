# Copy this file to `.env` next to docker-compose.yml on the EC2 instance
# and fill in real values. `.env` should never be committed.

# --- Database ---
POSTGRES_DB=doclift
POSTGRES_USER=doclift
POSTGRES_PASSWORD=change-me

# --- Images (overridden by CD to a specific tag/sha; defaults to :latest) ---
BACKEND_IMAGE=ghcr.io/amalitech-training-academy/doclift-backend:latest
FRONTEND_IMAGE=ghcr.io/amalitech-training-academy/doclift-frontend:latest
CADDY_IMAGE=ghcr.io/amalitech-training-academy/doclift-caddy:latest

# --- Caddy / TLS ---
# Public hostname Caddy requests a Let's Encrypt cert for. With an Elastic IP
# and no real domain yet, nip.io works: replace dots with dashes, e.g.
# an IP of 3.120.45.9 becomes 3-120-45-9.nip.io
DOMAIN=change-me.nip.io
ACME_EMAIL=admin@example.com
